model Transaction {
  id                   String            @id @default(uuid()) @db.Uuid
  reference            String            @unique
  type                 TransactionType
  status               TransactionStatus
  amount               BigInt            @db.BigInt
  currency             Currency
  description          String?
  provider             PaymentProvider?
  providerReference    String?           @map("provider_reference")
  paymentUrl           String?           @map("payment_url")
  customerEmail        String?           @map("customer_email")
  customerName         String?           @map("customer_name")
  providerResponse     Json?             @map("provider_response")
  paidAt               DateTime?         @map("paid_at") @db.Timestamptz(6)
  expiresAt            DateTime?         @map("expires_at") @db.Timestamptz(6)
  failureCode          String?           @map("failure_code")
  failureMessage       String?           @map("failure_message")
  initiatedByUserId    String?           @map("initiated_by_user_id") @db.Uuid
  sourceAccountId      String?           @map("source_account_id") @db.Uuid
  destinationAccountId String?           @map("destination_account_id") @db.Uuid
  idempotencyScope     String?           @map("idempotency_scope")
  idempotencyKey       String?           @map("idempotency_key")
  metadata             Json?
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  initiatedByUser User?         @relation(fields: [initiatedByUserId], references: [id])
  sourceAccount  LedgerAccount? @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount LedgerAccount? @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id])
  ledgerEntries  LedgerEntry[]

  @@unique([idempotencyScope, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([initiatedByUserId, createdAt])
  @@map("transactions")
}
