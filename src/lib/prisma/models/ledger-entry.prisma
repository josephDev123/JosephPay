model LedgerEntry {
  id              String          @id @default(uuid()) @db.Uuid
  transactionId   String          @map("transaction_id") @db.Uuid
  ledgerAccountId String          @map("ledger_account_id") @db.Uuid
  entryType       LedgerEntryType @map("entry_type")
  amount          BigInt          @db.BigInt
  currency        Currency
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([ledgerAccountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}
