NODE_ENV=production
PORT=5000

# Use the connection string supplied by the managed PostgreSQL provider.
DATABASE_URL=postgresql://app_user:replace-with-a-secret@managed-db.example.com:5432/fintech_platform?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@example.com
DOJAH_SECRET_KEY=replace-with-dojah-secret
DOJAH_APP_ID=replace-with-dojah-app-id
DOJAH_BASE_URL=https://api.dojah.io
PAYSTACK_SECRET_KEY=replace-with-paystack-secret
